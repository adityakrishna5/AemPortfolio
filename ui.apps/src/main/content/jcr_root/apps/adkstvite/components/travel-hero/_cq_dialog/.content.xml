<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Travel Hero"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs">
        <items jcr:primaryType="nt:unstructured">

            <!-- Tab: Image & Badge -->
            <image
                jcr:primaryType="nt:unstructured"
                jcr:title="Image"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <heroImage
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Background Image (DAM)"
                        fieldDescription="Select an image from the DAM."
                        name="./heroImage"
                        rootPath="/content/dam"/>
                    <badgeText
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Badge Text"
                        fieldDescription="Small uppercase label above the headline."
                        name="./badgeText"/>
                </items>
            </image>

            <!-- Tab: Text -->
            <text
                jcr:primaryType="nt:unstructured"
                jcr:title="Text"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <headline
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Headline (first line)"
                        name="./headline"/>
                    <headlineAccent
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Headline Accent (second line — amber colour)"
                        name="./headlineAccent"/>
                    <subheadline
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                        fieldLabel="Subheadline"
                        name="./subheadline"
                        rows="{Long}4"/>
                </items>
            </text>

            <!-- Tab: CTAs -->
            <ctas
                jcr:primaryType="nt:unstructured"
                jcr:title="CTAs"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <cta1Label
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Primary CTA Label"
                        name="./cta1Label"/>
                    <cta1Href
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Primary CTA Link"
                        name="./cta1Href"
                        rootPath="/content"/>
                    <cta2Label
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Secondary CTA Label"
                        name="./cta2Label"/>
                    <cta2Href
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Secondary CTA Link"
                        name="./cta2Href"
                        rootPath="/content"/>
                </items>
            </ctas>

        </items>
    </content>
</jcr:root>
