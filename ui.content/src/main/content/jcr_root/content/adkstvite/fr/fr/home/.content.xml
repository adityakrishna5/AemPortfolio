<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/adkstvite/settings/wcm/templates/travel-page"
        jcr:description="AdventureTrails — page d'accueil avec héros, à propos, et destinations vedettes"
        jcr:language="fr"
        jcr:primaryType="cq:PageContent"
        jcr:title="Accueil"
        navTitle="Accueil"
        pageTitle="AdventureTrails — Découvrez votre prochaine aventure"
        sling:resourceType="adkstvite/components/page/travel-page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adkstvite/components/container"
            layout="responsiveGrid">

            <main-content
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adkstvite/components/container"
                layout="responsiveGrid">

                <hero-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-hero"
                    heroImage="/content/dam/wknd-shared/en/adventures/ski-touring-mont-blanc/adobestock-238230356.jpeg"
                    badgeText="Voyage d'aventure premium"
                    headline="Votre prochaine grande"
                    headlineAccent="Aventure vous attend"
                    subheadline="Des expéditions guidées par des experts vers les destinations les plus époustouflantes du monde. Des sommets enneigés aux côtes ensoleillées — nous vous y emmenons."
                    cta1Label="Explorer les destinations"
                    cta1Href="/content/adkstvite/fr/fr/about-us.html"
                    cta2Label="En savoir plus"
                    cta2Href="/content/adkstvite/fr/fr/about-us.html"/>

                <about-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-about"
                    aboutImage="/content/dam/wknd-shared/en/adventures/riverside-camping-australia/adobestock-167833331.jpeg"
                    overline="À propos d'AdventureTrails"
                    headline="Nous ne réservons pas seulement des voyages."
                    headlineAccent="Nous créons des expéditions."
                    para1="Née d'un amour des grands espaces, AdventureTrails a été fondée pour connecter les voyageurs passionnés avec des expériences extraordinaires hors des sentiers battus. Chaque itinéraire est conçu à la main par des experts qui ont vécu le voyage eux-mêmes."
                    para2="Nous croyons que le voyage doit vous transformer. Nos expéditions sont conçues pour repousser vos limites, vous faire découvrir des cultures remarquables et vous laisser des histoires qui durent toute une vie."
                    stat1Value="12k"
                    stat1Label="Aventuriers guidés"
                    stat2Value="48"
                    stat2Label="Pays explorés"
                    stat3Value="98%"
                    stat3Label="Taux de satisfaction"
                    stat4Value="14"
                    stat4Label="Années d'expérience"
                    ctaLabel="Notre histoire"
                    ctaHref="/content/adkstvite/fr/fr/about-us.html"/>

                <destinations-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-destinations"
                    overline="Destinations populaires"
                    heading="Découvrez le monde avec nous"
                    description="Des expéditions triées sur le volet pour les audacieux et les curieux — chaque destination est vérifiée par notre équipe d'experts en aventure."
                    exploreTripLabel="Voir l'expédition">
                    <items jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            title="Ski de Haute Montagne Mont Blanc"
                            location="Chamonix, Alpes françaises"
                            description="Parcourez les emblématiques pistes de ski d'altitude sur le toit de l'Europe. Glaciers, couloirs et panoramas à couper le souffle vous attendent à chaque crête."
                            image="/content/dam/wknd-shared/en/adventures/ski-touring-mont-blanc/adobestock-273139829.jpeg"
                            href="/content/adkstvite/fr/fr/about-us.html"
                            tag="Alpine"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            title="Camp de Rivière Outback"
                            location="Australie Occidentale"
                            description="Dormez sous un ciel étoilé au bord de rivières ancestrales. Explorez des gorges rouges, nagez dans des bassins rocheux cristallins et entendez l'appel sauvage de l'outback."
                            image="/content/dam/wknd-shared/en/adventures/riverside-camping-australia/adobestock-167833331.jpeg"
                            href="/content/adkstvite/fr/fr/about-us.html"
                            tag="Nature sauvage"/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            title="Trek au Sommet Alpin"
                            location="Massif du Mont Blanc, Italie"
                            description="Traversée sur plusieurs jours d'un terrain alpin légendaire — sentiers de refuge en refuge, crêtes vertigineuses et couchers de soleil dorés au-dessus des nuages."
                            image="/content/dam/wknd-shared/en/adventures/ski-touring-mont-blanc/adobestock-75620750.jpeg"
                            href="/content/adkstvite/fr/fr/about-us.html"
                            tag="Randonnée"/>
                    </items>
                </destinations-mount>

            </main-content>

        </root>
    </jcr:content>
</jcr:root>
