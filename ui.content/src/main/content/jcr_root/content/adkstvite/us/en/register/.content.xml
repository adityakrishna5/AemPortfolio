<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/adkstvite/settings/wcm/templates/travel-page"
        jcr:description="Register a free AdventureTrails account — start planning your next expedition"
        jcr:primaryType="cq:PageContent"
        jcr:title="Register"
        navTitle="Register"
        pageTitle="Register — AdventureTrails"
        sling:resourceType="adkstvite/components/page/travel-page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adkstvite/components/container"
            layout="responsiveGrid">

            <!--/* LOCKED: header mount */-->
            <travel-header-area
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adkstvite/components/container">
                <header-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-header"
                    brandName="AdventureTrails"
                    brandHref="/content/adkstvite/us/en/home.html"
                    signInLabel="Sign In"
                    signInHref="/content/adkstvite/us/en/sign-in.html"
                    registerLabel="Register"
                    registerHref="/content/adkstvite/us/en/register.html">
                    <navItems jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured" label="Home" href="/content/adkstvite/us/en/home.html"/>
                        <item1 jcr:primaryType="nt:unstructured" label="About Us" href="/content/adkstvite/us/en/about-us.html"/>
                    </navItems>
                </header-mount>
            </travel-header-area>

            <!--/* EDITABLE: Register form */-->
            <main-content
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adkstvite/components/container"
                layout="responsiveGrid">
                <!--/* RegisterForm */-->
                <register-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-register"
                    heading="Create your account"
                    description="Join thousands of adventurers — start planning your next expedition today."/>
            </main-content>

            <!--/* LOCKED: footer mount */-->
            <travel-footer-area
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adkstvite/components/container">
                <footer-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-footer"
                    brandName="AdventureTrails"
                    brandHref="/content/adkstvite/us/en/home.html"
                    tagline="Connecting adventurers with extraordinary destinations since 2010.">
                    <quickLinks jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured" label="Home" href="/content/adkstvite/us/en/home.html"/>
                        <item1 jcr:primaryType="nt:unstructured" label="About Us" href="/content/adkstvite/us/en/about-us.html"/>
                        <item2 jcr:primaryType="nt:unstructured" label="Sign In" href="/content/adkstvite/us/en/sign-in.html"/>
                        <item3 jcr:primaryType="nt:unstructured" label="Register" href="/content/adkstvite/us/en/register.html"/>
                    </quickLinks>
                    <topDestinations jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured" label="Arctic Surfing, Norway" href="/content/adkstvite/us/en/about-us.html"/>
                        <item1 jcr:primaryType="nt:unstructured" label="Svalbard Trekking" href="/content/adkstvite/us/en/about-us.html"/>
                        <item2 jcr:primaryType="nt:unstructured" label="Iceland Ring Road" href="/content/adkstvite/us/en/about-us.html"/>
                        <item3 jcr:primaryType="nt:unstructured" label="Scottish Highlands" href="/content/adkstvite/us/en/about-us.html"/>
                        <item4 jcr:primaryType="nt:unstructured" label="Patagonia Crossing" href="/content/adkstvite/us/en/about-us.html"/>
                    </topDestinations>
                </footer-mount>
            </travel-footer-area>

        </root>
    </jcr:content>
</jcr:root>
