<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:template="/conf/adkstvite/settings/wcm/templates/travel-page"
        jcr:description="About AdventureTrails — our story, mission, and the team behind your adventures"
        jcr:primaryType="cq:PageContent"
        jcr:title="About Us"
        navTitle="About Us"
        pageTitle="About Us — AdventureTrails"
        sling:resourceType="adkstvite/components/page/travel-page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="adkstvite/components/container"
            layout="responsiveGrid">

            <!--/* EDITABLE: About page content */-->
            <main-content
                jcr:primaryType="nt:unstructured"
                sling:resourceType="adkstvite/components/container"
                layout="responsiveGrid">

                <!--/* About component */-->
                <about-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-about"
                    aboutImage="/content/dam/wknd-shared/en/adventures/riverside-camping-australia/adobestock-167833331.jpeg"
                    overline="About AdventureTrails"
                    headline="We Don't Just Book Trips."
                    headlineAccent="We Craft Expeditions."
                    para1="Born from a love of wild places, AdventureTrails was founded to connect passionate travellers with extraordinary, off-the-beaten-path experiences. Every itinerary is handcrafted by experts who have lived the journey themselves."
                    para2="We believe travel should transform you. Our expeditions are designed to stretch your limits, introduce you to remarkable cultures, and leave you with stories that last a lifetime."
                    stat1Value="12k" stat1Label="Adventurers Guided"
                    stat2Value="48" stat2Label="Countries Explored"
                    stat3Value="98%" stat3Label="Satisfaction Rate"
                    stat4Value="14" stat4Label="Years of Experience"
                    ctaLabel="Our Story"
                    ctaHref="/content/adkstvite/us/en/about-us.html"/>

                <!--/* Destinations on About page for inspiration */-->
                <destinations-mount
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="adkstvite/components/travel-destinations"
                    overline="Where to Next"
                    heading="Featured Destinations"
                    description="Handpicked expeditions for the bold and the curious.">
                    <items jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured"
                            title="Mont Blanc Ski Touring" location="Chamonix, French Alps"
                            description="Tackle iconic high-altitude ski routes across the roof of Europe."
                            image="/content/dam/wknd-shared/en/adventures/ski-touring-mont-blanc/adobestock-273139829.jpeg"
                            href="/content/adkstvite/us/en/about-us.html" tag="Alpine"/>
                        <item1 jcr:primaryType="nt:unstructured"
                            title="Outback River Camp" location="Western Australia"
                            description="Sleep under a blanket of stars beside ancient rivers."
                            image="/content/dam/wknd-shared/en/adventures/riverside-camping-australia/adobestock-167833331.jpeg"
                            href="/content/adkstvite/us/en/about-us.html" tag="Wilderness"/>
                        <item2 jcr:primaryType="nt:unstructured"
                            title="Alpine Summit Trek" location="Mont Blanc Massif, Italy"
                            description="Multi-day traverse of legendary alpine terrain."
                            image="/content/dam/wknd-shared/en/adventures/ski-touring-mont-blanc/adobestock-75620750.jpeg"
                            href="/content/adkstvite/us/en/about-us.html" tag="Trekking"/>
                    </items>
                </destinations-mount>
            </main-content>

        </root>
    </jcr:content>
</jcr:root>
