{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "baseUrl": "../ui.frontend",
        "removeComments": true,
        "allowJs": true,
        "preserveConstEnums": true,
        "allowSyntheticDefaultImports": true,
        "sourceMap": true,
        "jsx": "react-jsx",
        "strict": false,
        "lib": ["ES2020", "DOM", "DOM.Iterable"]
    },
    "include": [ "./src/**/*.ts", "./src/**/*.tsx" ]
}
