{
  "alloworigin": ["http://localhost:3000"],
  "allowedpaths": [
    "/(content|conf)/adkstvite.*",
    "/bin/adkstvite/auth/login",
    "/bin/adkstvite/auth/signup",
    "/bin/adkstvite/auth/logout",
    "/bin/adkstvite/auth/userinfo",
    "/bin/adkstvite/auth/refresh",
    "/bin/adkstvite/auth/csrf"
  ],
  "supportedheaders": [
    "Authorization",
    "Origin",
    "Accept",
    "X-Requested-With",
    "Content-Type",
    "Access-Control-Request-Method",
    "Access-Control-Request-Headers",
    "X-CSRF-Token"
  ],
  "supportedmethods": ["GET","HEAD","POST"],
  "allowcredentials": true,
  "alloworiginregexp": []
}